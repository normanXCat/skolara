{
    "compilerOptions": {
        "target": "ES2020",
        "module": "commonjs",
        "outDir": "./dist",
        "rootDir": "./src",
        "strict": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true,
        "resolveJsonModule": true,
        "declaration": true,
        "declarationMap": true,
        "sourceMap": true,
        "types": ["node", "jest"],
        "baseUrl": ".",
        "paths": {
            "@prisma/client": ["./src/generated/prisma"]
        }
    },
    "include": ["src/**/*"],
    "exclude": ["node_modules", "dist"]
}
